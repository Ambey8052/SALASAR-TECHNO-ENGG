NODE_ENV=development
PORT=5001

# Use a separate database for development. A local server pointed at the production database
# runs a second copy of the sync and email crons against it.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/salasar

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5001/api/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5001/api/auth/google/connect-drive/callback
GMAIL_SEND_REDIRECT_URI=http://localhost:5001/api/auth/google/connect-gmail/callback

# Both are required on any deployed server — it refuses to start with the development fallbacks.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string

ADMIN_EMAILS=someone@example.com

# Who may sign in: any verified address at these domains (comma-separated), plus anyone listed
# in ALLOWED_LOGIN_EMAILS. Admins and EMAIL_USER are always allowed. "*" allows any Google
# account (the old behaviour).
ALLOWED_LOGIN_DOMAINS=salasartechno.com
ALLOWED_LOGIN_EMAILS=

# No trailing slash (it is normalised, but keep it exact).
CLIENT_ORIGIN=http://localhost:5173

HSD_SPREADSHEET_ID=1-O9T8zA4yAFYzq9LW2fgn5hIdy7MsAPq
# Drive folder of the monthly Dispatch Synopsis workbooks (one .xlsx per month).
SYNOPSIS_FOLDER_ID=1RBlqtBL3l2qnyKxRzF0FZ_p7ruYKQRni
SYNC_INTERVAL_MINUTES=10

GEMINI_API_KEY=your-gemini-api-key

# The one account allowed to use the Email feature. Sending goes through the Gmail API (SMTP is
# blocked on Render), authorised once from the Email page while signed in as this account.
EMAIL_USER=someone@example.com
